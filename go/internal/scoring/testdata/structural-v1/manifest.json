    "relative_epsilon": 0.02,
    "meaningful_delta": 0.5,
    "raw_metric_tolerance": 0.000001,
    "rank_tie": "abs(score_delta) <= max(score_epsilon, relative_epsilon * max(abs(scores)))",
    "unrelated_regression": "within the same candidate policy, unchanged functions/files in a transformed case may not regress by more than max(0.5, 0.02 * max(abs(baseline), 1)); do not compare absolute scores across policy versions",
