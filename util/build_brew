#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_repository="${SLOPWATCH_SOURCE_REPOSITORY:-blater/slopwatch}"
tap_repository="${SLOPWATCH_TAP_REPOSITORY:-blater/homebrew-tap}"
version="${SLOPWATCH_RELEASE_VERSION:-}"
dist_dir="$script_dir/dist"
formula_path="$dist_dir/Formula/slopwatch.rb"
local_mode=false

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || \
  die "SLOPWATCH_RELEASE_VERSION must use X.Y.Z numeric format."
case "${1:-}" in
  "") ;;
  local) local_mode=true ;;
  *) die "Usage: SLOPWATCH_RELEASE_VERSION=X.Y.Z ./util/build_brew [local]" ;;
esac
if (($# > 1)); then
  die "Usage: SLOPWATCH_RELEASE_VERSION=X.Y.Z ./util/build_brew [local]"
fi
if [[ "$local_mode" == false ]]; then
  command -v gh >/dev/null 2>&1 || die "gh is required."
fi

archive_name="slopwatch-${version}-darwin-arm64.tar.gz"
archive_path="$dist_dir/$archive_name"
[[ -f "$archive_path" ]] || die "$archive_path does not exist."
checksum="$(shasum -a 256 "$archive_path" | awk '{print $1}')"
mkdir -p "$(dirname "$formula_path")"

cat > "$formula_path" <<FORMULA
class Slopwatch < Formula
  desc "Native code-quality scoring and live slopwatch dashboard"
  homepage "https://github.com/$source_repository"
  url "https://github.com/$source_repository/releases/download/v$version/$archive_name"
  version "$version"
  sha256 "$checksum"
  license "MIT"

  depends_on arch: :arm64
  depends_on macos: :sequoia
  depends_on "node"

  def install
    libexec.install "build", "analyzers", "component-catalog.json"
    bin.write_exec_script libexec/"build/slopmark"
    bin.write_exec_script libexec/"build/slopwatch"
  end

  test do
    assert_match "usage: slopmark", shell_output("#{bin}/slopmark --help 2>&1")
    assert_match "usage: slopmark", shell_output("#{bin}/slopwatch --help 2>&1")
  end
end
FORMULA

brew style "$formula_path"
if [[ "$local_mode" == true ]]; then
  printf 'Created local Homebrew formula: %s\n' "$formula_path"
  exit 0
fi
temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/slopwatch-brew.XXXXXX")"
trap 'rm -rf "$temporary_dir"' EXIT
tap_worktree="$temporary_dir/homebrew-tap"
gh repo clone "$tap_repository" "$tap_worktree"
mkdir -p "$tap_worktree/Formula"
cp "$formula_path" "$tap_worktree/Formula/slopwatch.rb"
git -C "$tap_worktree" add Formula/slopwatch.rb

if git -C "$tap_worktree" diff --cached --quiet; then
  printf 'Homebrew tap is already current.\n'
  exit 0
fi

github_login="$(gh api user --jq .login)"
git -C "$tap_worktree" \
  -c user.name="${GIT_AUTHOR_NAME:-$github_login}" \
  -c user.email="${GIT_AUTHOR_EMAIL:-$github_login@users.noreply.github.com}" \
  commit -m "slopwatch $version"
git -C "$tap_worktree" push origin HEAD
printf 'Published Homebrew formula for SlopWatch %s.\n' "$version"
