+func gradedPackageShadow(u unit, name string) bool {
+	depth := 0
+	for i, t := range u.tokens {
+		if t.text == "{" {
+			depth++
+		}
+		if t.text == "}" {
+			depth--
+		}
+		if depth != 0 || i == 0 || t.text != name {
+			continue
+		}
+		switch u.tokens[i-1].text {
+		case "var", "const", "type", "struct", "class", "fn", "func":
+			return true
+		}
+	}
+	return false
+}
