+		}
+		if tok.text == "=" && i > 0 && gradeOwnedFieldReference(op, u, body, i-1) {
+			end := statementEnd(body, i+1)
+			for j := i + 1; j < end; j++ {
+				if body[j].text == "{" && matching(body, j, "{", "}") >= 0 {
+					return true
+				}
+			}
+		}
+	}
+	return false
